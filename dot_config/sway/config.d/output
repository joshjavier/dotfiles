### Output configuration
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs
#
# You can also bind workspaces 1,2,3 to specific outputs
#
# workspace 1 output eDP-2
# workspace 2 output HDMI-A-1
# workspace 3 output DP-1
#
# Wacom Tablet - Example
#   input "1386:884:Wacom_Intuos_S_Pad" map_to_output HDMI-A-1
#   input "1386:884:Wacom_Intuos_S_Pen" map_to_output HDMI-A-1

# Multihead setup as of 2025-01-23
set $laptop eDP-1
set $main "Dell Inc. DELL U2412M 77PYH6BJ08BU" 

output $main {
	resolution 1920x1200
	position 0 0
}

output $laptop {
	resolution 1366x768
	position 0 1200
}

# Clamshell Mode
# See: https://github.com/swaywm/sway/wiki#clamshell-mode
bindswitch --reload --locked lid:on output $laptop disable
bindswitch --reload --locked lid:off output $laptop enable

# When reloading sway while using clamshell mode, the displays may reset
# (i.e. both displays will be enabled). This script should prevent that:
exec_always ../scripts/clamshell.sh
